# Copy this file to .env.local and fill in the values

# ===========================
# ====== App Settings =======
# ===========================
LOBE_PORT=3210
APP_URL=http://localhost:3210

# ===========================
# ====== Auth Secrets =======
# ===========================
# Generate with: openssl rand -base64 32
KEY_VAULTS_SECRET=your-key-vaults-secret-here
AUTH_SECRET=your-auth-secret-here

# ===========================
# ====== Database ===========
# ===========================
LOBE_DB_NAME=afintrix
POSTGRES_PASSWORD=changeme-strong-password

# ===========================
# ====== S3 / RustFS ========
# ===========================
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=changeme-strong-password
RUSTFS_LOBE_BUCKET=lobe

# ===========================
# ====== AI Providers =======
# ===========================
# Uncomment and set the keys you need

# OpenAI
# OPENAI_API_KEY=sk-...
# ENABLED_OPENAI=1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# DeepSeek
# DEEPSEEK_API_KEY=...

# Groq
# GROQ_API_KEY=...

# ===========================
# ====== Auth / SSO =========
# ===========================
# Optional: restrict login to specific emails
# AUTH_ALLOWED_EMAILS=user@afintrix.com

# Optional: Google OAuth
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...

# Optional: GitHub OAuth
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
