# ===========================
# ====== App Settings =======
# ===========================
LOBE_PORT=3210

# Public URL of the application — used for OAuth redirects, email links, etc.
APP_URL=https://assistant.afintrix.com

# ===========================
# ====== Auth Secrets =======
# ===========================
KEY_VAULTS_SECRET=k5aZe3Qml5LPaGNbSLkH/9BaPFk3dJmwyssanAn1OFE=
AUTH_SECRET=Ld6DAknl6jU1CAHIEujfYy+R5Q+tQtKWevNeKUPAW+c=

# ===========================
# ====== Database ===========
# ===========================
LOBE_DB_NAME=afintrix
POSTGRES_PASSWORD=lobechat_pass

# Connection string used by the app container to reach PostgreSQL (Docker internal hostname)
DATABASE_URL=postgresql://postgres:lobechat_pass@postgresql:5432/afintrix

# ===========================
# ====== S3 / RustFS ========
# ===========================
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=changeme123
RUSTFS_LOBE_BUCKET=lobe

S3_BUCKET=lobe
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=changeme123

# Public S3 endpoint — must be reachable by browsers for file/image uploads.
# Point your reverse proxy so that https://s3.assistant.afintrix.com → rustfs:9000
S3_ENDPOINT=https://s3.assistant.afintrix.com

# ===========================
# ====== AI Providers =======
# ===========================
# Uncomment and fill in the keys you need

# OpenAI
# OPENAI_API_KEY=sk-...
# ENABLED_OPENAI=1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# DeepSeek
# DEEPSEEK_API_KEY=...

# Groq
# GROQ_API_KEY=...

# ===========================
# ====== Auth / SSO =========
# ===========================
# Optional: restrict login to specific emails
# AUTH_ALLOWED_EMAILS=user@afintrix.com

# Optional: Google OAuth
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...

# Optional: GitHub OAuth
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
